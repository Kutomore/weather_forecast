<h1>Weather Forecast</h1>

<%= form_with url: root_path, method: :get, data: { turbo_frame: "forecast", turbo_action: "advance" } do |f| %>
  <%= f.label :zip, "ZIP code" %>
  <%= f.text_field :zip, value: params[:zip], required: true, pattern: '\d{5}(-\d{4})?', inputmode: "numeric", autocomplete: "postal-code" %>

  <%= f.submit "Get forecast", name: nil, data: { turbo_submits_with: "Loading…" } %>
<% end %>

<%= turbo_frame_tag "forecast", aria: { live: "polite" } do %>
    <%= render @forecast if @forecast %>
    <% if @error %>
        <p class='error' role='alert'><%= @error %></p>
    <% end%>
<% end %>