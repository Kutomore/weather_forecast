<section class="forecast">
  <h2><%= forecast.location %></h2>

  <% if forecast.cached %>
    <p class="cache-status"><mark>Cached result</mark> from <%= time_ago_in_words(forecast.fetched_at) %> ago</p>
  <% end %>

  <p class="temperature"><%= forecast.current_temp.round %>°F</p>
  <p class="high-low">High <%= forecast.high.round %>° · Low <%= forecast.low.round %>°</p>

  <ul class="days">
    <% forecast.daily.each do |day| %>
      <li>
        <span><%= day.date.strftime("%a %-d") %></span>
        <span><%= day.high.round %>° / <%= day.low.round %>°</span>
      </li>
    <% end %>
  </ul>
</section>
